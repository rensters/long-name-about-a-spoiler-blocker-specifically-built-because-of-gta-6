{
  "manifest_version": 3,
  "name": "Spoiler Shield",
  "short_name": "Spoiler Shield",
  "version": "1.0.0",
  "description": "Blurs GTA VI (or any topic you pick) all over YouTube, Reddit, X, Twitch and more until you're ready. Runs 100% locally.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Spoiler Shield",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "src/background.js",
    "scripts": ["src/lib/shim.js", "src/lib/normalize.js", "src/lib/packs.js", "src/lib/store.js", "src/background.js"]
  },
  "permissions": ["storage", "alarms", "notifications"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "exclude_matches": ["*://www.youtube.com/live_chat*", "*://www.youtube.com/live_chat_replay*"],
      "run_at": "document_start",
      "all_frames": false,
      "css": ["src/content/page.css"],
      "js": [
        "src/lib/shim.js",
        "src/lib/normalize.js",
        "src/lib/matcher.js",
        "src/lib/packs.js",
        "src/lib/store.js",
        "src/sites/_registry.js",
        "src/sites/youtube.js",
        "src/sites/reddit.js",
        "src/sites/x.js",
        "src/sites/twitch.js",
        "src/sites/kick.js",
        "src/sites/tiktok.js",
        "src/sites/instagram.js",
        "src/sites/facebook.js",
        "src/sites/threads.js",
        "src/sites/bluesky.js",
        "src/sites/discord.js",
        "src/sites/google.js",
        "src/sites/bing.js",
        "src/sites/generic.js",
        "src/content/early.js",
        "src/content/collect.js",
        "src/content/shield.js",
        "src/content/stream.js",
        "src/content/engine.js",
        "src/content/main.js"
      ]
    },
    {
      "matches": ["*://www.youtube.com/live_chat*", "*://www.youtube.com/live_chat_replay*"],
      "run_at": "document_start",
      "all_frames": true,
      "css": ["src/content/page.css"],
      "js": [
        "src/lib/shim.js",
        "src/lib/normalize.js",
        "src/lib/matcher.js",
        "src/lib/packs.js",
        "src/lib/store.js",
        "src/sites/_registry.js",
        "src/sites/youtube.js",
        "src/content/early.js",
        "src/content/collect.js",
        "src/content/shield.js",
        "src/content/stream.js",
        "src/content/engine.js",
        "src/content/main.js"
      ]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "spoiler-shield@local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
