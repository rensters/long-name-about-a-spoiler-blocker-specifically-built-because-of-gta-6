{
  "name": "spoilerphobia",
  "version": "1.0.0",
  "private": true,
  "description": "Browser extension that blurs GTA VI (or any topic) across social media. No build step: load the folder unpacked.",
  "scripts": {
    "test": "node --test \"tests/unit/*.test.js\"",
    "test:e2e": "playwright test",
    "test:all": "npm test && npm run test:e2e",
    "lint:firefox": "web-ext lint --source-dir . --ignore-files \"node_modules/**\" \"tests/**\" \"dist/**\" \"tools/**\" \"docs/**\" \"docs\" \"tools\" \"tests\" \"test-results/**\" \"playwright-report/**\" \"*.md\" \"package*.json\" \"playwright.config.js\"",
    "icons": "node tools/make-icons.js",
    "package": "node tools/build.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "web-ext": "^10.8.0"
  },
  "license": "Unlicense"
}
